# Claude Code process observability (Foundation B).
#
# Source this file before launching Claude Code to stream dev-session telemetry
# (token usage, cost, tool-call counts, latency) to an OpenTelemetry collector:
#
#   set -a; source .claude/telemetry.env; set +a
#   claude
#
# Point it at any OTLP endpoint — a local collector, Grafana Alloy, or an
# OTEL-compatible backend. Copy to `.claude/telemetry.env` and edit.

export CLAUDE_CODE_ENABLE_TELEMETRY=1
export OTEL_METRICS_EXPORTER=otlp
export OTEL_LOGS_EXPORTER=otlp
export OTEL_EXPORTER_OTLP_PROTOCOL=grpc
export OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Shorten the export interval while demoing so metrics show up fast (ms).
export OTEL_METRIC_EXPORT_INTERVAL=10000
export OTEL_LOGS_EXPORT_INTERVAL=5000
