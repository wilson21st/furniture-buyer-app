# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# NEVER commit real keys. The repo is public.
# ---------------------------------------------------------------------------

# --- App ---
APP_SECRET_KEY=change-me-to-a-long-random-string   # session signing
DATABASE_URL=sqlite:///./data/app.db
ENV=dev                                             # `prod` enforces secure config at startup

# --- Web hardening (defaults are dev-safe; tighten for a real deployment) ---
ALLOWED_HOSTS=*                                     # comma-separated host allow-list, e.g. app.example.com
FORCE_HTTPS=false                                   # true behind a TLS-terminating proxy
SESSION_HTTPS_ONLY=                                 # blank => secure cookies iff ENV=prod
SEED_DEMO_USER=true                                 # known-credential demo user; MUST be false in prod
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60                            # per-client cap on /buy, /orders, /chat

# --- Furniture shop API (Steps 3–6) ---
# Ask an organizer for the base URL and your personal key/User ID.
FURNITURE_API_BASE_URL=https://day1.training.cognitivo.com.au
FURNITURE_API_KEY=                                  # your personal X-Api-Key
FURNITURE_USER_ID=u001                              # your assigned user id
USE_REAL_API=false                                  # false = local SQLite (L1); true = live shop API (L2+)

# --- Shared read-only catalogue (Step 2 seed) ---
CATALOGUE_MONGO_URI=mongodb+srv://training:NEOOzWI0Ta8QsFY2@hackathon.qivdl6n.mongodb.net/catalog?appName=Hackathon

# --- Anthropic (Step 6 agent, Step 8 generation) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Embeddings for RAG (Step 8). Anthropic does not embed; use Voyage. ---
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3

# --- Langfuse (self-hosted, Steps 5/6/8 runtime observability) ---
# The docker-compose stack provisions these keys headlessly, so they work as-is
# once `docker compose -f docker-compose.langfuse.yml up -d` is healthy.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-hackathon-public
LANGFUSE_SECRET_KEY=sk-lf-hackathon-secret
LANGFUSE_ENABLED=false          # set true to stream traces to the local Langfuse

# --- Claude Code process observability (Foundation B) ---
# Export these in your shell (not read by the app) to send dev-session
# telemetry to an OTEL collector. See .claude/telemetry.env.example.
