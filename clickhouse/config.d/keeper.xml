<clickhouse>
  <!-- Single-node embedded Keeper + a one-replica `default` cluster so Langfuse's
       `ON CLUSTER default` / ReplicatedMergeTree migrations work without a separate
       ZooKeeper. Standard pattern for self-hosting Langfuse on one machine. -->
  <keeper_server>
    <tcp_port>9181</tcp_port>
    <server_id>1</server_id>
    <log_storage_path>/var/lib/clickhouse/coordination/log</log_storage_path>
    <snapshot_storage_path>/var/lib/clickhouse/coordination/snapshots</snapshot_storage_path>
    <coordination_settings>
      <operation_timeout_ms>10000</operation_timeout_ms>
      <session_timeout_ms>30000</session_timeout_ms>
    </coordination_settings>
    <raft_configuration>
      <server>
        <id>1</id>
        <hostname>localhost</hostname>
        <port>9234</port>
      </server>
    </raft_configuration>
  </keeper_server>

  <zookeeper>
    <node>
      <host>localhost</host>
      <port>9181</port>
    </node>
  </zookeeper>

  <macros>
    <shard>01</shard>
    <replica>01</replica>
    <cluster>default</cluster>
  </macros>

  <remote_servers>
    <default>
      <shard>
        <internal_replication>true</internal_replication>
        <replica>
          <host>localhost</host>
          <port>9000</port>
        </replica>
      </shard>
    </default>
  </remote_servers>
</clickhouse>
